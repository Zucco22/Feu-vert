{
  "expo": {
    "name": "Feu Vert",
    "slug": "feu-vert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#58CC02"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#58CC02"
    },
    "plugins": [
      "expo-audio",
      "expo-notifications"
    ]
  }
}
